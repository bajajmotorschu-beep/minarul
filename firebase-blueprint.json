{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name of the user", "maxLength": 100 },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Bangladeshi contact phone number", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "admin"], "description": "User authorization role" },
        "address": { "type": "object", "description": "Default shipping address" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Clothing apparel product in the fashion catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "titleEn": { "type": "string", "description": "English product title", "maxLength": 150 },
        "titleBn": { "type": "string", "description": "Bangla product title", "maxLength": 150 },
        "category": { "type": "string", "enum": ["men", "women", "children", "festive"] },
        "subCategory": { "type": "string" },
        "price": { "type": "number", "description": "Selling price in BDT" },
        "originalPrice": { "type": "number" },
        "images": { "type": "array", "description": "Product image URLs" },
        "descriptionEn": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "stock": { "type": "number", "description": "Inventory stock count" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "fabric": { "type": "string" },
        "sku": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "titleEn", "price", "stock", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order identifier" },
        "orderId": { "type": "string", "description": "Unique order tracking ID" },
        "customerId": { "type": "string", "description": "Auth UID or customer identifier" },
        "customerName": { "type": "string", "description": "Recipient customer name" },
        "customerEmail": { "type": "string", "description": "Customer email address" },
        "customerPhone": { "type": "string", "description": "Contact phone number" },
        "shippingAddress": { "type": "object", "description": "Delivery address and recipient details" },
        "items": { "type": "array", "description": "Order item details" },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "bkash", "nagad", "rocket"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "submitted", "pending"] },
        "senderMobile": { "type": "string", "description": "Sender mobile number for mobile banking" },
        "transactionId": { "type": "string", "description": "Transaction ID from SMS" },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "packaging", "shipped", "delivered", "cancelled"] },
        "couponCode": { "type": "string" },
        "courierName": { "type": "string" },
        "courierTrackingId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderId", "shippingAddress", "items", "totalAmount", "paymentMethod", "orderStatus"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount vouchers and promotional codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "descriptionEn": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "discountType", "discountValue", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer feedback and product rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoneMasked": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" }
      },
      "required": ["productId", "userName", "rating", "comment"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration, delivery rates and merchant numbers",
      "type": "object",
      "properties": {
        "announcementEn": { "type": "string" },
        "announcementBn": { "type": "string" },
        "hotline": { "type": "string" },
        "whatsapp": { "type": "string" },
        "supportEmail": { "type": "string" },
        "bkashMerchantNumber": { "type": "string" },
        "nagadMerchantNumber": { "type": "string" },
        "rocketMerchantNumber": { "type": "string" },
        "dhakaDeliveryFee": { "type": "number" },
        "outsideDhakaDeliveryFee": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "flagshipAddressEn": { "type": "string" },
        "flagshipAddressBn": { "type": "string" }
      }
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Homepage carousel banner slides",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "badgeEn": { "type": "string" },
        "badgeBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleBn": { "type": "string" },
        "subtitleEn": { "type": "string" },
        "subtitleBn": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "titleEn", "image", "isActive"]
    },
    "PhoneLookup": {
      "title": "PhoneLookup",
      "description": "Maps normalized Bangladeshi mobile numbers to Firebase Auth credentials for mobile login",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "phone"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Inventory movement log",
      "type": "object",
      "properties": {
        "movementId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" }
      },
      "required": ["movementId", "productId", "type", "quantity"]
    },
    "CashTransaction": {
      "title": "CashTransaction",
      "description": "Cash in hand and account transactions",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["transactionId", "type", "amount", "paymentMethod"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Product vendor and supplier profiles",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "openingDue": { "type": "number" },
        "currentDue": { "type": "number" }
      },
      "required": ["name", "phone", "openingDue"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Stock purchase order and inbound inventory record",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "items": { "type": "array" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" }
      },
      "required": ["purchaseId", "supplierId", "items", "grandTotal"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational business expense record",
      "type": "object",
      "properties": {
        "expenseId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "expenseDate": { "type": "string" }
      },
      "required": ["expenseId", "category", "amount", "paymentMethod"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Recorded customer order sale with COGS and gross profit",
      "type": "object",
      "properties": {
        "saleId": { "type": "string" },
        "orderId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "totalCost": { "type": "number" },
        "grossProfit": { "type": "number" }
      },
      "required": ["saleId", "orderId", "totalAmount"]
    },
    "SupplierPayment": {
      "title": "SupplierPayment",
      "description": "Payment made to product supplier against dues",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "supplierId": { "type": "string" },
        "paymentAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["paymentId", "supplierId", "paymentAmount", "paymentMethod"]
    },
    "StockAdjustment": {
      "title": "StockAdjustment",
      "description": "Manual inventory adjustment and correction record",
      "type": "object",
      "properties": {
        "adjustmentId": { "type": "string" },
        "productId": { "type": "string" },
        "adjustmentType": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" }
      },
      "required": ["adjustmentId", "productId", "adjustmentType", "quantity"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered customer and admin profiles"
    },
    "/phoneLookup/{phone}": {
      "schema": "PhoneLookup",
      "description": "Index for mobile number based login"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of fashion items and apparel"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders and fulfillment tracking"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional coupon codes"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer reviews"
    },
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Website global configuration and store settings"
    },
    "/heroSlides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Homepage dynamic promotional banners"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Inventory movements"
    },
    "/stockAdjustments/{adjustmentId}": {
      "schema": "StockAdjustment",
      "description": "Stock adjustments and counts"
    },
    "/cashTransactions/{transactionId}": {
      "schema": "CashTransaction",
      "description": "Cash transactions"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers and vendors"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Inbound stock purchases"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operating expenses"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Recorded order sales with COGS"
    },
    "/supplierPayments/{paymentId}": {
      "schema": "SupplierPayment",
      "description": "Supplier payment receipts"
    },
    "/transactions/{transactionId}": {
      "schema": "CashTransaction",
      "description": "Ledger and journal transactions"
    },
    "/returns/{returnId}": {
      "schema": "object",
      "description": "Product sales and purchase returns"
    },
    "/payments/{paymentId}": {
      "schema": "object",
      "description": "Customer payments and refunds"
    },
    "/accounts/{accountId}": {
      "schema": "object",
      "description": "Financial opening balances and account setups"
    }
  }
}
